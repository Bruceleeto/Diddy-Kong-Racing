	src/joypad.c \
	src/lights.c \
	src/main.c \
	src/memory.c \
	src/menu.c \
	src/object_functions.c \
	src/object_models.c \
	src/objects.c \
	src/os_yield_data.c \
	src/particles.c \
	src/printf.c \
	src/racer.c \
	src/rcp_dkr.c \
	src/save_data.c \
	src/screen_asset.c \
	src/set_rsp_segment.c \
	src/textures_sprites.c \
	src/thread0_epc.c \
	src/thread30_bgload.c \
	src/thread3_main.c \
	src/tracks.c \
