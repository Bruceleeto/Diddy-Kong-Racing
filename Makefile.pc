O_FILES := $(addprefix $(BUILD)/,$(SRC_FILES:.c=.o) $(LIBULTRA_FILES:.c=.o))
D_FILES := $(O_FILES:.o=.d)

TARGET := dkracing

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(O_FILES)
	$(CC) -m$(BITS) $(O_FILES) -o $(TARGET) -lm

$(BUILD)/linux/%.o: linux/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS_REIMPL) -c -o $@ $<

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD) $(TARGET)

-include $(D_FILES)
