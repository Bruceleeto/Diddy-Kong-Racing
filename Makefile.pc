# Makefile.pc — native Linux build of the DKR game code (the port).
#
# Usage:
#   make -f Makefile.pc -j8            # build ./dkracing
#   make -f Makefile.pc clean
#
# Notes:
# - BITS=32 by default: the decomp assumes 4-byte pointers everywhere (structs
#   overlaying ROM data, pointers stashed in u32). 64-bit comes later, on purpose.
# - libultra C files ARE built (only the hand-written .s files — CP0/cache/
#   exception/boot — get replaced by host shims). Files that poke MMIO registers
#   (io/, timers) will need #ifdef TARGET_PC surgery or shim replacements, but
#   they start out in the build so the worklist is visible as compile errors.
# - src/hasm/softfloat_conv.c and llmuldiv_gcc.s excluded: host libgcc provides those.
# - -DTARGET_PC replaces -DTARGET_N64; use it to #ifdef the platform split.

CC      := gcc
BITS    ?= 32
BUILD   := build/pc

DEFINES := \
	-DTARGET_PC \
	-D_LANGUAGE_C \
	-D_FINALROM \
	-DNDEBUG \
	-DF3DDKR_GBI \
	-DVERSION_US_V77 \
	-DAVOID_UB \
	-DNON_MATCHING \
	-DBUILD_VERSION=VERSION_G \
	-DBUILD_VERSION_STRING=\"2.0G\" \
	-D_MIPS_SZLONG=32

# linux/ (platform code) compiles WITHOUT -I include/libc: those headers are N64
# stubs that shadow the real system libc (their stdio.h only declares sprintf).
# Game code keeps the shadow; platform code gets the host's actual headers.
INCLUDES_REIMPL := \
	-I . \
	-I include \
	-I include/PR \
	-I include/sys \
	-I assets \
	-I src \
	-I src/hasm \
	-I libultra \
	-I libultra/src/gu \
	-I libultra/src/libc \
	-I libultra/src/io \
	-I libultra/src/sc \
	-I libultra/src/audio \
	-I libultra/src/os

INCLUDES := -I include/libc $(INCLUDES_REIMPL)

OPT      ?= -O1
BASE_CFLAGS := -m$(BITS) $(OPT) -g $(DEFINES) \
	-fno-builtin \
	-fno-common \
	-fno-strict-aliasing \
	-funsigned-char \
	-fwrapv \
	-MMD -MP
CFLAGS        := $(BASE_CFLAGS) $(INCLUDES)
CFLAGS_REIMPL := $(BASE_CFLAGS) $(INCLUDES_REIMPL)

# Every game-code source file, individually.
SRC_FILES := \
	linux/main.c \
	linux/reimpl.c \
	src/asset_loading.c \
	src/audio.c \
	src/audiomgr.c \
