	libultra/src/os/thread.c \
	libultra/src/os/timerintr.c \
	libultra/src/os/virtualtophysical.c \
	libultra/src/os/yieldthread.c \
	libultra/src/sc/sched.c

O_FILES := $(addprefix $(BUILD)/,$(SRC_FILES:.c=.o) $(LIBULTRA_FILES:.c=.o))
D_FILES := $(O_FILES:.o=.d)

TARGET := dkracing.elf
MAP    := $(TARGET:.elf=.map)

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(O_FILES)
	$(CC) $(O_FILES) -o $(TARGET) -s -Wl,-Map,$(MAP) $(LIBS)

$(BUILD)/dreamcast/%.o: dreamcast/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS_REIMPL) -c -o $@ $<

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD) $(TARGET) $(MAP)

-include $(D_FILES)
