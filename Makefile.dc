
include $(KOS_BASE)/Makefile.rules

CC      := kos-cc
BUILD   := build/dc
PYTHON  ?= $(shell for candidate in .venv/bin/python3 /opt/homebrew/bin/python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3; do if command -v "$$candidate" >/dev/null 2>&1; then command -v "$$candidate"; break; fi; done)
PYTHON_310_OR_NEWER := $(shell $(PYTHON) -c 'import sys; print(int(sys.version_info >= (3, 10)))' 2>/dev/null)
ifneq ($(PYTHON_310_OR_NEWER),1)
$(error DKR AICAflow builds require Python 3.10+; set PYTHON=/path/to/python3.10-or-newer)
endif
PYTHON_HAS_MIDO := $(shell $(PYTHON) -c 'import mido' >/dev/null 2>&1 && echo 1)
ifneq ($(PYTHON_HAS_MIDO),1)
$(error DKR AICAflow builds require the Python package mido; run $(PYTHON) -m pip install mido)
endif

DKR_ASSET_MOUNT ?= /pc
ifneq ($(DKR_ASSET_MOUNT),/pc)
ifneq ($(DKR_ASSET_MOUNT),/cd)
$(error DKR_ASSET_MOUNT must be /pc or /cd)
endif
endif

AICAFLOW_ROOT := third_party/aicaflow
AICAFORGE_ROOT := $(AICAFLOW_ROOT)/dependencies/AICAforge
AICAFORGE_BIN := $(AICAFORGE_ROOT)/build
AICAFLOW_BENCHMARK ?= 0

DEFINES := \
	-DTARGET_PC \
	-DTARGET_DC \
	-D_LANGUAGE_C \
	-D_FINALROM \
	-DNDEBUG \
	-DF3DDKR_GBI \
	-DVERSION_US_V77 \
	-DAVOID_UB \
	-DNON_MATCHING \
	-DBUILD_VERSION=VERSION_G \
	-DBUILD_VERSION_STRING=\"2.0G\" \
	-D_MIPS_SZLONG=32 \
	-DPC_MAIN_POOL_BYTES='(3 * 1024 * 1024)' \
	-DGBI_FLOAT_MTX \
	-DAUDIO_NO_REVERB

DEFINES += -DDKR_AICAFLOW -DDKR_AICAFLOW_BENCHMARK=$(AICAFLOW_BENCHMARK)
LIBS := $(AICAFLOW_ROOT)/driver/sh4/libaicaflow_host.a -lsh4zam -lm


# Seed the RAM-backed EEPROM with the 100%-completion image in
# include/eeprom_preset.h (slots 1 and 2 complete) instead of erased 0xFF.
# On by default; disable with: make -f Makefile.dc EEPROM_PRESET_100=0
EEPROM_PRESET_100 ?= 1
ifeq ($(EEPROM_PRESET_100),1)
DEFINES += -DEEPROM_PRESET_100
endif


INCLUDES_REIMPL := \
	-I$(BUILD) \
	-I . \
	-I include \
	-I include/PR \
	-I include/sys \
	-I assets \
	-I src \
	-I src/hasm \
	-I libultra \
	-I libultra/src/gu \
	-I libultra/src/io \
	-I libultra/src/sc \
	-I libultra/src/audio \
	-I libultra/src/os

INCLUDES_REIMPL += -I$(AICAFLOW_ROOT)/driver/include -I$(AICAFLOW_ROOT)/driver/format/include -I$(AICAFLOW_ROOT)/driver/sh4/include -I$(BUILD)/aicaflow
INCLUDES := $(INCLUDES_REIMPL)

OPT      ?= -O3

SHZ_BACKEND ?= SHZ_SH4
FAST_MATH   ?= $(if $(filter SHZ_SW,$(SHZ_BACKEND)),-fno-fast-math,-ffast-math)

BASE_CFLAGS := $(OPT) -g $(DEFINES) \
	-std=gnu23 \
	-fno-common \
	-fno-strict-aliasing \
	-Wno-int-conversion \
	-funsigned-char \
	-fwrapv \
	-ffp-contract=fast \
	-fsingle-precision-constant \
	-mfsrra \
	-mfsca \
	-flto \
	-DSHZ_BACKEND=$(SHZ_BACKEND) \
	$(FAST_MATH)
BASE_CFLAGS += -MMD -MP

LTO_FLAGS := $(OPT) $(filter -f%,$(BASE_CFLAGS)) $(filter -m%,$(BASE_CFLAGS))
CFLAGS        := $(BASE_CFLAGS) $(INCLUDES)
CFLAGS_REIMPL := $(BASE_CFLAGS) $(INCLUDES_REIMPL)

# Every game-code source file, individually.
SRC_FILES := \
