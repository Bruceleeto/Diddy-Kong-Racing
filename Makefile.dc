
include $(KOS_BASE)/Makefile.rules

CC      := kos-cc
BUILD   := build/dc

DEFINES := \
	-DTARGET_PC \
	-DTARGET_DC \
	-D_LANGUAGE_C \
	-D_FINALROM \
	-DNDEBUG \
	-DF3DDKR_GBI \
	-DVERSION_US_V77 \
	-DAVOID_UB \
	-DNON_MATCHING \
	-DBUILD_VERSION=VERSION_G \
	-DBUILD_VERSION_STRING=\"2.0G\" \
	-D_MIPS_SZLONG=32


INCLUDES_REIMPL := \
	-I . \
	-I include \
	-I include/PR \
	-I include/sys \
	-I assets \
	-I src \
	-I src/hasm \
	-I libultra \
	-I libultra/src/gu \
	-I libultra/src/libc \
	-I libultra/src/io \
	-I libultra/src/sc \
	-I libultra/src/audio \
	-I libultra/src/os

INCLUDES := -I include/libc $(INCLUDES_REIMPL)

OPT      ?= -O3

BASE_CFLAGS := $(OPT) -g $(DEFINES) \
	-std=gnu23 \
	-fno-builtin \
	-fno-common \
	-fno-strict-aliasing \
	-funsigned-char \
	-fwrapv \
	-MMD -MP
CFLAGS        := $(BASE_CFLAGS) $(INCLUDES)
CFLAGS_REIMPL := $(BASE_CFLAGS) $(INCLUDES_REIMPL)

# KOS pulls in its own libm/newlib via kos-cc; no SDL/GL on Dreamcast.
LIBS := -lm

# Every game-code source file, individually.
SRC_FILES := \
	dreamcast/main.c \
	dreamcast/audio.c \
	dreamcast/audio_hle.c \
	dreamcast/gfx.c \
	dreamcast/input.c \
	dreamcast/reimpl.c \
	src/asset_loading.c \
	src/audio.c \
	src/audiomgr.c \
	src/audiosfx.c \
	src/audio_spatial.c \
	src/audio_vehicle.c \
	src/borders.c \
	src/camera.c \
	src/fade_transition.c \
	src/font.c \
	src/game.c \
	src/game_text.c \
	src/game_ui.c \
	src/get_stack_pointer.c \
	src/gzip.c \
	src/joypad.c \
	src/lights.c \
	src/main.c \
